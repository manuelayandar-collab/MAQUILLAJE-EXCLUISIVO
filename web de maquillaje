        let cart = [];
        let currentFilter = "all";
        let searchQuery = "";
        let activeModalShade = null;

        // DOM SELECTORS
        const productsGrid = document.getElementById('products-grid');
        const filterBtns = document.querySelectorAll('.filter-btn');
        const searchInput = document.getElementById('search-input');
        const mobileSearchInput = document.getElementById('mobile-search-input');
        const cartBtn = document.getElementById('cart-btn');
        const cartCount = document.getElementById('cart-count');
        const cartDrawer = document.getElementById('cart-drawer');
        const cartBackdrop = document.getElementById('cart-backdrop');
        const closeCartBtn = document.getElementById('close-cart-btn');
        const cartItemsContainer = document.getElementById('cart-items-container');
        const cartSubtotal = document.getElementById('cart-subtotal');
        const cartTotal = document.getElementById('cart-total');
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const productModal = document.getElementById('product-modal');
        const modalBackdrop = document.getElementById('modal-backdrop');
        const closeModalBtn = document.getElementById('close-modal-btn');
        const modalContent = document.getElementById('modal-content');
        const checkoutBtn = document.getElementById('checkout-btn');

        // INIT APP
        document.addEventListener('DOMContentLoaded', () => {
            renderProducts();
            setupEventListeners();
        });

        function renderProducts() {
            let filtered = products.filter(p => {
                const matchesFilter = currentFilter === 'all' || p.brand === currentFilter;
                const matchesSearch = p.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                                      p.brand.toLowerCase().includes(searchQuery.toLowerCase()) ||
                                      p.category.toLowerCase().includes(searchQuery.toLowerCase());
                return matchesFilter && matchesSearch;
            });

            if (filtered.length === 0) {
                productsGrid.innerHTML = `
                    <div class="col-span-full text-center py-16">
                        <i class="fa-solid fa-sparkles text-3xl text-gold-400 mb-3"></i>
                        <p class="text-gray-400 text-xs">No se encontraron productos exclusivos que coincidan con tu búsqueda.</p>
                    </div>
                `;
                return;
            }

            productsGrid.innerHTML = filtered.map(p => `
                <div class="group bg-lux-card rounded-2xl border border-gray-800/80 overflow-hidden card-glow transition-all duration-500 flex flex-col justify-between">
                    <div>
                        <div class="relative h-64 overflow-hidden bg-lux-dark cursor-pointer" onclick="openModal(${p.id})">
                            <img src="${p.image}" alt="${p.name}" class="w-full h-full object-cover group-hover:scale-105 transition duration-700 ease-out">
                            <div class="absolute top-3 left-3 bg-lux-black/90 backdrop-blur-md px-3 py-1 rounded-full border border-gold-400/30">
                                <span class="text-[9px] uppercase tracking-[0.2em] text-gold-300 font-bold">${p.brand}</span>
                            </div>
                            <button onclick="event.stopPropagation(); openModal(${p.id})" class="absolute bottom-3 right-3 bg-white/90 text-lux-black w-8 h-8 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition duration-300 shadow-lg">
                                <i class="fa-solid fa-eye text-xs"></i>
                            </button>
                        </div>

                        <div class="p-5">
                            <div class="flex items-center justify-between text-[11px] text-gray-400 mb-1">
                                <span>${p.category}</span>
                                <div class="flex items-center gap-1 text-gold-400">
                                    <i class="fa-solid fa-star text-[9px]"></i>
                                    <span class="font-bold text-white text-xs">${p.rating}</span>
                                </div>
                            </div>
                            <h3 class="font-serif text-lg font-bold text-white group-hover:text-gold-300 transition duration-300 cursor-pointer" onclick="openModal(${p.id})">${p.name}</h3>
                            <p class="text-gray-400 text-xs line-clamp-2 mt-2 font-light leading-relaxed">${p.description}</p>
                            
                            <div class="flex items-center gap-1.5 mt-3 pt-3 border-t border-gray-800/60">
                                <span class="text-[10px] text-gray-500 uppercase font-medium">Tonos:</span>
                                ${p.shades.map(s => `
                                    <span class="w-3.5 h-3.5 rounded-full border border-white/20 swatch-circle" style="background-color: ${s.color}" title="${s.name}"></span>
                                `).join('')}
                            </div>
                        </div>
                    </div>

                    <div class="p-5 pt-0 flex items-center justify-between mt-2">
                        <span class="font-serif text-lg font-bold text-gold-300">$${p.price.toFixed(2)} USD</span>
                        <button onclick="addToCart(${p.id})" class="px-4 py-2 border border-gold-400/40 text-gold-300 hover:bg-gold-400 hover:text-lux-black font-semibold text-[11px] uppercase tracking-wider rounded-full transition duration-300 flex items-center gap-1.5">
                            <i class="fa-solid fa-plus text-[9px]"></i> Añadir
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function setFilter(brand) {
            currentFilter = brand;
            filterBtns.forEach(b => {
                const attr = b.getAttribute('data-filter');
                if (attr === brand) {
                    b.classList.remove('bg-lux-card', 'text-gray-300');
                    b.classList.add('bg-gold-400', 'text-lux-black');
                } else {
                    b.classList.remove('bg-gold-400', 'text-lux-black');
                    b.classList.add('bg-lux-card', 'text-gray-300');
                }
            });
            renderProducts();
            document.getElementById('catalogo').scrollIntoView({ behavior: 'smooth' });
        }

        function setupEventListeners() {
            filterBtns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const filter = e.target.getAttribute('data-filter');
                    setFilter(filter);
                });
            });

            searchInput.addEventListener('input', (e) => {
                searchQuery = e.target.value;
                renderProducts();
            });

            mobileSearchInput.addEventListener('input', (e) => {
                searchQuery = e.target.value;
                renderProducts();
            });

            cartBtn.addEventListener('click', toggleCart);
            closeCartBtn.addEventListener('click', toggleCart);
            cartBackdrop.addEventListener('click', toggleCart);

            mobileMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            closeModalBtn.addEventListener('click', closeModal);
            modalBackdrop.addEventListener('click', closeModal);

            checkoutBtn.addEventListener('click', () => {
                if (cart.length === 0) return;
                showNotification("¡Gracias por su compra exclusiva! Su pedido VIP ha sido procesado.");
                cart = [];
                updateCart();
                toggleCart();
            });
        }

        function addToCart(productId, selectedShade = null) {
            const product = products.find(p => p.id === productId);
            const shadeName = selectedShade || (product.shades[0] ? product.shades[0].name : "");
            
            const cartKey = `${productId}-${shadeName}`;
            const existing = cart.find(item => item.cartKey === cartKey);

            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({
                    ...product,
                    cartKey: cartKey,
                    selectedShade: shadeName,
                    quantity: 1
                });
            }

            updateCart();
            showNotification(`Se añadió "${product.name}" (${shadeName}) a tu bolsa.`);
        }

        function removeFromCart(cartKey) {
            cart = cart.filter(item => item.cartKey !== cartKey);
            updateCart();
        }

        function changeQuantity(cartKey, delta) {
            const item = cart.find(i => i.cartKey === cartKey);
            if (item) {
                item.quantity += delta;
                if (item.quantity <= 0) {
                    removeFromCart(cartKey);
                } else {
                    updateCart();
                }
            }
        }

        function updateCart() {
            const totalCount = cart.reduce((sum, item) => sum + item.quantity, 0);
            cartCount.textContent = totalCount;

            if (cart.length === 0) {
                cartItemsContainer.innerHTML = `
                    <div class="text-center py-16 text-gray-500">
                        <i class="fa-solid fa-bag-shopping text-4xl mb-3 text-gray-600"></i>
                        <p class="text-xs">Tu bolsa de compras está vacía.</p>
                    </div>
                `;
            } else {
                cartItemsContainer.innerHTML = cart.map(item => `
                    <div class="flex items-center justify-between bg-lux-card p-3.5 rounded-xl border border-gray-800">
                        <img src="${item.image}" alt="${item.name}" class="w-14 h-14 object-cover rounded-lg">
                        <div class="flex-1 px-3">
                            <span class="text-[9px] text-gold-400 font-bold uppercase tracking-wider">${item.brand}</span>
                            <h4 class="text-xs font-semibold text-white line-clamp-1">${item.name}</h4>
                            <p class="text-[10px] text-gray-400">Tono: ${item.selectedShade}</p>
                            <span class="text-xs text-gold-300 font-serif font-bold">$${item.price.toFixed(2)} USD</span>
                        </div>
                        <div class="flex items-center gap-2 bg-lux-dark p-1 rounded-lg border border-gray-800">
                            <button onclick="changeQuantity('${item.cartKey}', -1)" class="w-5 h-5 text-gray-300 hover:text-gold-300 text-xs font-bold">-</button>
                            <span class="text-xs text-white font-bold w-4 text-center">${item.quantity}</span>
                            <button onclick="changeQuantity('${item.cartKey}', 1)" class="w-5 h-5 text-gray-300 hover:text-gold-300 text-xs font-bold">+</button>
                        </div>
                    </div>
                `).join('');
            }

            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            cartSubtotal.textContent = `$${subtotal.toFixed(2)} USD`;
            cartTotal.textContent = `$${subtotal.toFixed(2)} USD`;
        }

        function toggleCart() {
            cartDrawer.classList.toggle('hidden');
        }

        function openModal(productId) {
            const p = products.find(prod => prod.id === productId);
            activeModalShade = p.shades[0] ? p.shades[0].name : "";

            modalContent.innerHTML = `
                <div class="h-64 sm:h-80 rounded-2xl overflow-hidden bg-lux-dark border border-gray-800 relative">
                    <img id="modal-img" src="${p.image}" alt="${p.name}" class="w-full h-full object-cover">
                    <div class="absolute top-3 left-3 bg-lux-black/80 px-3 py-1 rounded-full border border-gold-400/30">
                        <span class="text-[9px] uppercase tracking-widest text-gold-300 font-bold">${p.brand}</span>
                    </div>
                </div>
                <div class="space-y-4">
                    <div>
                        <span class="text-[10px] uppercase tracking-widest text-rose-300 font-semibold">${p.category}</span>
                        <h2 class="text-2xl font-serif font-bold text-white mt-0.5">${p.name}</h2>
                    </div>
                    
                    <p class="text-xs text-gray-300 font-light leading-relaxed">${p.description}</p>
                    
                    <div class="bg-lux-dark p-3 rounded-xl border border-gray-800 space-y-1">
                        <span class="text-[10px] text-gold-400 font-bold uppercase tracking-wider block"><i class="fa-solid fa-wand-magic-sparkles mr-1"></i> Modo de Uso</span>
                        <p class="text-[11px] text-gray-300 font-light">${p.usage}</p>
                    </div>

                    <div>
                        <span class="text-[10px] text-gray-400 uppercase font-semibold block mb-2">Seleccionar Tono: <span id="selected-shade-title" class="text-white font-bold">${activeModalShade}</span></span>
                        <div class="flex flex-wrap gap-2">
                            ${p.shades.map((s, idx) => `
                                <button onclick="selectModalShade('${s.name}')" class="shade-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full border ${idx === 0 ? 'border-gold-400 bg-gold-400/10' : 'border-gray-800 bg-lux-dark'} text-xs text-gray-200 hover:border-gold-400 transition" data-shade="${s.name}">
                                    <span class="w-3.5 h-3.5 rounded-full border border-white/30" style="background-color: ${s.color}"></span>
                                    <span class="text-[10px]">${s.name}</span>
                                </button>
                            `).join('')}
                        </div>
                    </div>

                    <div class="flex items-center justify-between pt-4 border-t border-gray-800">
                        <span class="font-serif text-2xl font-bold text-gold-300">$${p.price.toFixed(2)} USD</span>
                        <button onclick="addToCart(${p.id}, activeModalShade); closeModal();" class="px-6 py-3 rose-gold-bg text-lux-black font-bold text-xs uppercase tracking-widest rounded-full hover:shadow-lg transition duration-300">
                            Añadir a la Bolsa
                        </button>
                    </div>
                </div>
            `;
            productModal.classList.remove('hidden');
        }

        function selectModalShade(shadeName) {
            activeModalShade = shadeName;
            document.getElementById('selected-shade-title').textContent = shadeName;
            
            document.querySelectorAll('.shade-btn').forEach(btn => {
                if (btn.getAttribute('data-shade') === shadeName) {
                    btn.classList.add('border-gold-400', 'bg-gold-400/10');
                    btn.classList.remove('border-gray-800', 'bg-lux-dark');
                } else {
                    btn.classList.remove('border-gold-400', 'bg-gold-400/10');
                    btn.classList.add('border-gray-800', 'bg-lux-dark');
                }
            });
        }

        function closeModal() {
            productModal.classList.add('hidden');
        }

        function showNotification(msg) {
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-6 right-6 z-50 glass-panel border border-gold-400/40 text-gold-300 px-6 py-3 rounded-full text-xs font-semibold shadow-2xl transition duration-500 transform translate-y-0 opacity-100 flex items-center gap-3';
            toast.innerHTML = `<i class="fa-solid fa-sparkles text-gold-400"></i> ${msg}`;
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-4');
                setTimeout(() => toast.remove(), 500);
            }, 3000);
        }
    </script>
